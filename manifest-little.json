{
  "id": "/littlelovely-app",
  "name": "Little Lovely Store",
  "short_name": "Little Lovely",
  "description": "Cute & Cozy Essentials for Little Ones",
  "start_url": "/littlelovely-store/little",
  "scope": "/littlelovely-store/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFC0CB",
  "theme_color": "#FF69B4",
  "lang": "hi",
  "dir": "ltr",
  "categories": ["shopping", "kids"],

"icons": [
  { "src": "/little-icon-192-any.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
  { "src": "/little-icon-512-any.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
  { "src": "/little-icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
  { "src": "/little-icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
],

"shortcuts": [
  {
    "name": "Shop",
    "short_name": "Shop",
    "description": "Browse all products",
    "url": "/shop.html",
    "icons": [{ "src": "/little-icon-192-any.png", "sizes": "192x192", "type": "image/png" }]
  },
  {
    "name": "Track Order",
    "short_name": "Track",
    "description": "Track your order status",
    "url": "/track-order.html",
    "icons": [{ "src": "/little-icon-192-any.png", "sizes": "192x192", "type": "image/png" }]
  },
  {
    "name": "Wishlist",
    "short_name": "Wishlist",
    "description": "View your wishlist",
    "url": "/wishlist.html",
    "icons": [{ "src": "/little-icon-192-any.png", "sizes": "192x192", "type": "image/png" }]
  },
  {
    "name": "Contact",
    "short_name": "Contact",
    "description": "Contact us",
    "url": "/contact.html",
    "icons": [{ "src": "/little-icon-192-any.png", "sizes": "192x192", "type": "image/png" }]
  }
],

  "screenshots": [
    {
      "src": "/icon/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Little Lovely Store Home"
    }
  ],

  "launch_handler": { "client_mode": "navigate-existing" },
  "prefer_related_applications": false,
  "related_applications": []
}